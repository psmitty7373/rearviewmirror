#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "icon.ico"

IDD_STREAM DIALOGEX 0, 0, 280, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Streaming"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_STREAM_STATUS, 12, 14, 190, 20
    PUSHBUTTON      "Start", IDC_STREAM_TOGGLE, 212, 12, 56, 16
    LTEXT           "UDP port:", -1, 12, 46, 64, 10
    EDITTEXT        IDC_STREAM_PORT, 80, 43, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Shared key:", -1, 12, 66, 64, 10
    EDITTEXT        IDC_STREAM_KEY, 80, 63, 100, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX    "Show", IDC_STREAM_SHOWKEY, 184, 65, 36, 10
    PUSHBUTTON      "Generate", IDC_STREAM_GENERATE, 222, 63, 46, 14
    LTEXT           "Bitrate (Mbps):", -1, 12, 86, 64, 10
    EDITTEXT        IDC_STREAM_BITRATE, 80, 83, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Frame rate (fps):", -1, 12, 106, 64, 10
    EDITTEXT        IDC_STREAM_FPS, 80, 103, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Upper limit, 1 to 240", -1, 146, 106, 122, 10
    LTEXT           "Encoder preset:", -1, 12, 126, 64, 10
    COMBOBOX        IDC_STREAM_PRESET, 80, 123, 138, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STREAM_ENCODER, 12, 146, 256, 10
    LTEXT           "", IDC_STREAM_HELP, 12, 160, 256, 34
    DEFPUSHBUTTON   "OK", IDOK, 166, 202, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 202, 48, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Rear View Mirror"
            VALUE "FileVersion",     "1.1.0.0"
            VALUE "InternalName",    "RearViewMirror"
            VALUE "OriginalFilename","RearViewMirror.exe"
            VALUE "ProductName",     "Rear View Mirror"
            VALUE "ProductVersion",  "1.1.0.0"
            VALUE "Comments",        "Selective picture-in-picture for Windows"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
