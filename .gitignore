# Signing certificates and keys: the code-signing certificate lives in the
# Windows certificate store and must never be exported into the repository.
*.pfx
*.p12
*.cer
*.crt
*.pvk
*.spc
*.key
*.pem

# Runtime settings, stream keys and logs live in %APPDATA%\RearViewMirror;
# copies of them never belong here.
*.ini
*.log
